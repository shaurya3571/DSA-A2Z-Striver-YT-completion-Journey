/*
Question:
Print numbers from N to 1 using recursion and backtracking.

Example:
Input: N = 5

Output:
5 4 3 2 1

Approach:
Move forward recursively first.
Print while returning from recursion.
*/

#include <iostream>
using namespace std;

void printNTo1_Backtracking(int i, int n) {
    if (i > n) return;   // Base Case

    printNTo1_Backtracking(i + 1, n);
    cout << i << " ";
}

int main() {
    int n;
    cin >> n;

    printNTo1_Backtracking(1, n);
    return 0;
}

/*
Time Complexity: O(N)
Space Complexity: O(N)
*/
