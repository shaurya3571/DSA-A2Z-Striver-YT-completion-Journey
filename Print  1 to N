/*
Question:
Print numbers from 1 to N using recursion.

Example:
Input: N = 5

Output:
1 2 3 4 5
*/

#include <iostream>
using namespace std;

void print1ToN(int i, int n) {
    if (i > n) return;   // Base Case

    cout << i << " ";
    print1ToN(i + 1, n);
}

int main() {
    int n;
    cin >> n;

    print1ToN(1, n);
    return 0;
}

/*
Time Complexity: O(N)
Space Complexity: O(N)
*/
